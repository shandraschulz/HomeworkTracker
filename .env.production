# Production Environment Configuration
# Copy this to .env and update values for production deployment

# Environment
ENVIRONMENT=production

# Database Configuration - CHANGE THESE!
POSTGRES_USER=homework
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=homework_tracker

# The DATABASE_URL is constructed automatically in docker-compose
# DATABASE_URL=postgresql://homework:PASSWORD@db:5432/homework_tracker

# CORS - Allowed Origins (your domain)
ALLOWED_ORIGINS=https://homework.jkbell.net

# Domain for Traefik routing - CHANGE THIS!
DOMAIN=homework.jkbell.net

# Traefik network name (matches homelab setup)
# Network: traefik
