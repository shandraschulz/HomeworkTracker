# Development Environment Configuration
# Copy this to .env for local development

# Environment
ENVIRONMENT=development

# Database Configuration
POSTGRES_USER=homework
POSTGRES_PASSWORD=homework_dev_password
POSTGRES_DB=homework_tracker
DATABASE_URL=postgresql://homework:homework_dev_password@db:5432/homework_tracker

# CORS - Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# Domain (not used in development)
DOMAIN=localhost
